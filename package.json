{
  "name": "engineering-visual-city",
  "private": true,
  "version": "0.9.0",
  "description": "ইঞ্জিনিয়ারিং ভিজ্যুয়াল সিটি - খেলতে খেলতে সিভিল, মেকানিক্যাল ও ইলেকট্রিক্যাল ইঞ্জিনিয়ারিং শেখার বাংলা ওপেন-ওয়ার্ল্ড গেম (Engineering Visual City: Bangla open-world engineering learning game)",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "game",
    "three.js",
    "rapier",
    "bangla",
    "engineering",
    "open-world",
    "education"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:farm": "tsx scripts/farm-test.ts",
    "test:vehicle-factory": "tsx scripts/vehicle-factory-test.ts",
    "test:farm-crew": "tsx scripts/farm-crew-test.ts",
    "gen:farm": "tsx scripts/gen-farm-fields.ts",
    "test:roads": "tsx scripts/road-test.ts",
    "test:port": "tsx scripts/port-test.ts",
    "test:airport": "tsx scripts/airport-test.ts && tsx scripts/airport-site-test.ts",
    "test:drive": "tsx scripts/drive-test.ts",
    "test:rivers": "tsx scripts/river-block.ts",
    "test:pads": "tsx scripts/pad-stat.ts",
    "test:eng-tour": "tsx scripts/engineering-tour-test.ts",
    "test:infra": "tsx scripts/infra-test.ts && tsx scripts/infra-runtime-test.ts && tsx scripts/thermal-test.ts && tsx scripts/grid-test.ts && tsx scripts/mech-test.ts && tsx scripts/dam-test.ts && tsx scripts/chem-test.ts && tsx scripts/automation-test.ts && tsx scripts/renew-test.ts && tsx scripts/vehicle-factory-test.ts && tsx scripts/techpark-test.ts && tsx scripts/engineering-tour-test.ts",
    "test:people": "tsx scripts/people-test.ts",
    "test:city": "tsx scripts/city-plan-test.ts",
    "test:zones": "tsx scripts/world-zones-test.ts",
    "test:eng-zones": "tsx scripts/eng-zones-test.ts",
    "test:proto-building": "tsx scripts/proto-building-test.ts",
    "test:placements": "tsx scripts/placements-test.ts",
    "fill:city": "tsx scripts/fill-city.ts",
    "test:fill": "tsx scripts/fill-test.ts",
    "test:fill-runtime": "esbuild scripts/fill-runtime-test.ts --bundle --platform=node --format=esm --loader:.jpg=dataurl --loader:.png=dataurl --outfile=node_modules/.fill-runtime.mjs --log-level=error && node node_modules/.fill-runtime.mjs",
    "test:signals": "tsx scripts/traffic-signal-test.ts",
    "test:rail": "tsx scripts/rail-plan-test.ts",
    "test:expressway": "tsx scripts/expressway-test.ts",
    "bake:expressway": "tsx scripts/expressway-bake.ts",
    "test:rail-mesh": "tsx scripts/rail-mesh-test.ts",
    "test:rail-links": "tsx scripts/rail-link-test.ts",
    "test:trains": "tsx scripts/train-sim-test.ts",
    "test:train-interior": "tsx scripts/train-interior-test.ts",
    "test:station-posts": "tsx scripts/station-post-test.ts",
    "test:station-signs": "tsx scripts/station-sign-test.ts",
    "test:trains-game": "tsx scripts/train-game-test.ts",
    "test:trains-physics": "tsx scripts/train-physics-test.ts",
    "test:trains-signals": "tsx scripts/train-signal-test.ts",
    "test:people-rail": "tsx scripts/people-rail-test.ts",
    "diag:people-lane": "tsx scripts/people-lane-diag.ts",
    "test:local-roads": "tsx scripts/local-roads-test.ts",
    "test:trees": "tsx scripts/tree-test.ts",
    "test:tree-physics": "tsx scripts/tree-physics-test.ts",
    "test:grass-rocks": "tsx scripts/grass-rock-test.ts",
    "test:combat": "tsx scripts/combat-test.ts",
    "test:ammo": "tsx scripts/ammo-test.ts",
    "test:vehicles": "tsx scripts/vehicle-test.ts",
    "test:vehicle-use": "tsx scripts/vehicle-use-test.ts",
    "test:street": "tsx scripts/street-test.ts",
    "test:tree-destruction": "tsx scripts/tree-destruction-test.ts",
    "test:birds": "tsx scripts/bird-test.ts",
    "test:boats": "tsx scripts/boat-test.ts",
    "test:mall": "tsx scripts/mall-test.ts",
    "test:library": "tsx scripts/library-test.ts",
    "test:army": "tsx scripts/army-site-test.ts",
    "test:airplane": "tsx scripts/airplane-test.ts",
    "test:sea-airport": "tsx scripts/sea-airport-test.ts",
    "test:agro": "tsx scripts/agro-site-test.ts",
    "test:animals": "tsx scripts/animals-test.ts",
    "test:wanted": "tsx scripts/wanted-test.ts",
    "test:start": "tsx scripts/start-test.ts",
    "test:daynight": "tsx scripts/daynight-test.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@fontsource/noto-sans-bengali": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
